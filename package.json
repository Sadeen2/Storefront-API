{
  "name": "storefront-api",
  "version": "1.0.0",
  "description": "Storefront REST API with PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "watch": "tsc-watch --esModuleInterop src/server.ts --outDir ./dist --onSuccess \"node ./dist/server.js\"",
    "test": "tsc && jasmine",
    "db-migrate-up": "db-migrate up",
    "db-migrate-down": "db-migrate down",
    "db-migrate-reset": "db-migrate reset"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.13",
    "db-migrate-pg": "^1.3.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^5.1.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "jasmine": "^5.1.0",
    "jasmine-spec-reporter": "^7.0.0",
    "supertest": "^6.3.4",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.3.3"
  }
}
